                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": []
              }
            },
            "required": [
              "id",
              "name",
              "source"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source": {
                      "const": "userpass"
                    }
                  }
                },
                "then": {
                  "required": [
                    "auth_mount",
                    "login"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "auth_mount"
                        ]
                      },
                      {
                        "required": [
                          "login"
                        ]
                      },
                      {
                        "required": [
                          "password"
                        ]
                      },
                      {
                        "required": [
                          "password_policy"
                        ]
                      },
                      {
                        "required": [
                          "token_parameters"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          },
          "uniqueItems": true,
          "minItems": 0
        }
      ]
    },
    "vault_configuration_groups": {
