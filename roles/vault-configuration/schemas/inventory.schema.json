              },
              "password": {
                "type": "string"
              },
              "password_policy": {
                "enum": [
                  "on_create",
                  "always"
                ]
              },
              "token_parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "token_ttl": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "token_max_ttl": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "token_explicit_max_ttl": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "token_period": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "token_num_uses": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "token_no_default_policy": {
                    "type": "boolean"
                  },
                  "token_type": {
                    "type": "string"
                  },
                  "token_bound_cidrs": {
                    "type": "array",
