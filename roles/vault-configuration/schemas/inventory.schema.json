                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
              },
              "source": {
                "enum": [
                  "userpass",
                  "external"
                ]
              },
              "disabled": {
