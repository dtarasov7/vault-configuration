                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "auth_mount": {
                      "type": "string",
                      "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*)?$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "auth_mount",
